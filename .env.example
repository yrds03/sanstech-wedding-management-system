# Server-only: URL Web App Apps Script dan secret acak minimal 32 karakter.
# Atur secret yang sama pada Script Properties Apps Script.
DRIVE_GATEWAY_URL=
DRIVE_GATEWAY_SECRET=

# Server-only: 32 byte acak, format 64 karakter hex. Simpan cadangan terpisah.
# Kunci ini mengenkripsi isi database; jangan ubah tanpa prosedur migrasi kunci.
DRIVE_ENCRYPTION_KEY=

# Server-only: OAuth Web Application dari Google Cloud Console.
# Redirect URI: https://DOMAIN/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Origin HTTPS produksi aplikasi.
NEXT_PUBLIC_APP_URL=

# Hanya pengembangan lokal; selalu ditolak di produksi/Vercel.
LOCAL_DEMO_MODE=
TOKEN_HASH_PEPPER=
