# ============================================================================
# SANSTECH Wedding Management System (WeddingHub) - Contoh Konfigurasi Env
# Salin file ini menjadi `.env.local` dan isi dengan nilai proyek Supabase Anda.
# JANGAN PERNAH melakukan commit `.env.local` atau membagikan SERVICE_ROLE_KEY.
# ============================================================================

# URL & Anon Key publik Supabase (aman untuk browser dengan perlindungan RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Kunci rahasia server Supabase (HANYA untuk server-side, JANGAN beri prefix NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# URL dasar aplikasi untuk tautan undangan publik & staf
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pepper rahasia server untuk hashing token QR / undangan publik / undangan anggota
TOKEN_HASH_PEPPER=ganti-dengan-random-string-minimal-32-karakter

