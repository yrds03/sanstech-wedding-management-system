# Isi dari proyek Supabase Anda. Nilai ini publik; keamanan data ditegakkan oleh RPC/RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin HTTPS produksi; boleh kosong di Vercel untuk menggunakan hostname deployment.
NEXT_PUBLIC_APP_URL=

# Hanya pengembangan lokal: isi true untuk menampilkan akun simulasi.
# Selalu dinonaktifkan otomatis pada NODE_ENV=production atau Vercel.
LOCAL_DEMO_MODE=

# Opsional, server-only, untuk hashing token simulasi lokal yang persisten.
TOKEN_HASH_PEPPER=
